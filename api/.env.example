# Just for local dev
PORT=3000
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_db?schema=public

# Redis Queue Configuration, just for local dev
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace_me_with_long_random_secret
JWT_EXPIRES_IN=15m

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_app_password
EMAIL_FROM_NAME=ERP

GOOGLE_CREDENTIALS_FILE=google-credentials.json

PROJECTS_SPREADSHEET_ID=1WEIN-40_8vn2K9bgYnTy3WE9KkVlR2NyhG6MxaBi-us
PROJECTS_SHEET_NAME=Zakres

# Integration API
INTEGRATION_API_KEY=my-super-secret-key-123

# Frontend origin(s) allowed by CORS, comma-separated (production: https://projects.ispik24.pl)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Telegram bug reports: bot token from @BotFather and Telegram ID of the admin who receives them
TELEGRAM_BOT_TOKEN=replace_me_with_bot_token
TELEGRAM_ADMIN_CHAT_ID=123456789

# Fakturownia
FAKTUROWNIA_API_TOKEN=text
FAKTUROWNIA_PL_SUBDOMAIN=text
FAKTUROWNIA_LV_SUBDOMAIN=text
FAKTUROWNIA_RO_SUBDOMAIN=text
FAKTUROWNIA_ES_SUBDOMAIN=text

# TMA (Telegram Mini App) live attendance: base API URL including /api, and the key TMA keeps in its INTEGRATION_API_KEY
TMA_API_URL=http://localhost:3009/api
TMA_API_KEY=replace_me_with_tma_integration_key

# Google Drive folder for works acceptance protocols (must be on a Shared drive; the service account needs Content manager access)
GOOGLE_DRIVE_PROTOCOLS_FOLDER_ID=1_JkmMTs5CElPqGnmFTa_Z4JzxayoAqg0

# Brigade app ST_BR: its own key for the integration API (header x-api-key)
ST_BR_API_KEY=replace_me_with_st_br_key

# Brigade app (foremen) sign-in: phone -> TMA confirms foreman + Telegram ID -> code sent by this bot
# Empty = the same bot as TELEGRAM_BOT_TOKEN. No token at all outside production = code is printed in the API log.
TELEGRAM_AUTH_BOT_TOKEN=
# http = ask TMA (TMA_API_URL + TMA_API_KEY + path below); stub = every number is a foreman (development only)
BRIGADE_TMA_MODE=http
TMA_FOREMAN_CHECK_PATH=/v1/integration/foremen/check
# Telegram ID that gets the code while BRIGADE_TMA_MODE=stub (default: TELEGRAM_ADMIN_CHAT_ID)
BRIGADE_STUB_TELEGRAM_ID=
# Brigade sessions end at 23:59:59 in this time zone
AUTH_TIME_ZONE=Europe/Warsaw

# Brigade app: Google Sheets of the former ST_BR (shared with the GOOGLE_CREDENTIALS_FILE service account).
# Projects and work types come from ERP; crew, vacations and history still from these sheets.
STBR_WORK_JOURNAL_SPREADSHEET_ID=
STBR_WORK_JOURNAL_SHEET_NAME=Roboty
STBR_EMPLOYEES_ISPIK_SPREADSHEET_ID=
STBR_EMPLOYEES_ISPIK_SHEET_NAME=ARKUSZ
STBR_EMPLOYEES_ISPIK_LV_SPREADSHEET_ID=
STBR_EMPLOYEES_ISPIK_LV_SHEET_NAME=Работники
STBR_EMPLOYEES_AGENCIES_SPREADSHEET_ID=
STBR_EMPLOYEES_AGENCIES_SHEET_NAME=join
STBR_VACATION_SPREADSHEET_ID=
STBR_VACATION_SHEET_NAME=Wnioski
STBR_RESIGNATION_SPREADSHEET_ID=
STBR_RESIGNATION_SHEET_NAME=Zwolnienie
