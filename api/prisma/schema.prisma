generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  Int                          @id @default(autoincrement())
  createdAt                           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  firstName                           String                       @map("first_name") @db.VarChar(255)
  lastName                            String                       @map("last_name") @db.VarChar(255)
  middleNames                         String?                      @map("middle_names") @db.VarChar(255)
  position                            String                       @db.VarChar(255)
  email                               String                       @unique @db.VarChar(255)
  phoneNumber                         String                       @unique @map("phone_number") @db.VarChar(16)
  telegramId                          BigInt?                      @map("telegram_id")
  isActive                            Boolean                      @default(true) @map("is_active")
  roles                               String[]
  contractor_id                       String?                      @db.Uuid
  authCodes                           AuthCode[]
  project_department_foremen          project_department_foremen[]
  project_status_history              project_status_history[]
  projects_projects_created_byTousers projects[]                   @relation("projects_created_byTousers")
  projects_projects_manager_idTousers projects[]                   @relation("projects_manager_idTousers")
  projects_projects_updated_byTousers projects[]                   @relation("projects_updated_byTousers")
  refreshTokens                       RefreshToken[]
  user_roles                          user_roles[]
  contractors                         contractors?                 @relation(fields: [contractor_id], references: [id])

  invoices_created invoices[] @relation("invoices_created_byTousers")

  @@map("users")
}

model AuthCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  userAgent String?
  createdAt DateTime @default(now())
  /// Where the code was sent: "email" (ERP sign-in) or "telegram" (brigade app). Codes never cross channels.
  channel   String   @default("email") @db.VarChar(20)
  /// Wrong guesses for this code; it is invalidated after a few
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code, isUsed, expiresAt])
  @@index([userId, channel, createdAt])
  @@map("auth_codes")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Which app the session belongs to: "erp" or "brigade" (brigade sessions end at 23:59 Warsaw time)
  scope     String    @default("erp") @db.VarChar(20)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model contractors {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(255)
  short_name  String?    @db.VarChar(100)
  tax_number  String?    @db.VarChar(100)
  street      String?    @db.VarChar(255)
  postal_code String?    @db.VarChar(20)
  city        String?    @db.VarChar(100)
  country     String?    @db.VarChar(100)
  notes       String?    @db.Text
  created_at  DateTime?  @default(now()) @db.Timestamptz(0)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(0)
  projects    projects[]
  users       User[]
}

model cost_categories {
  id               BigInt             @id @default(autoincrement())
  name             String             @db.VarChar(100)
  is_salary        Boolean?
  planned_expenses planned_expenses[]
}

model currencies {
  code     String     @id @db.Char(3)
  name     String?    @db.VarChar(50)
  symbol   String?    @db.VarChar(10)
  projects projects[]
}

model daily_reports {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_date        DateTime           @db.Date
  project_id         String             @db.Uuid
  work_type_id       String             @db.Uuid
  actual_workers     Int?
  actual_hours       Decimal?           @db.Decimal(10, 2)
  actual_quantity    Decimal?           @db.Decimal(18, 2)
  deleted_at         DateTime?          @db.Timestamptz(0)
  projects           projects           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_work_types project_work_types @relation(fields: [work_type_id], references: [id], onDelete: Cascade)
}

model departments {
  id                         BigInt                       @id @default(autoincrement())
  name                       String                       @unique @db.VarChar(100)
  description                String?
  icon                       String                       @default("Folder") @db.VarChar(50)
  is_active                  Boolean                      @default(true)
  project_department_foremen project_department_foremen[]
  project_departments        project_departments[]
  project_work_types         project_work_types[]
}

model milestones {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String                @db.Uuid
  milestone_no         String                @db.VarChar(50)
  description          String
  type                 String                @default("KM") @db.VarChar(30)
  percentage           Decimal?              @db.Decimal(5, 2)
  net_amount           Decimal?              @db.Decimal(15, 2)
  invoicing_percentage Decimal?              @db.Decimal(5, 2)
  deleted_at           DateTime?             @db.Timestamptz(0)
  created_at           DateTime?             @default(now()) @db.Timestamptz(0)
  updated_at           DateTime?             @default(now()) @db.Timestamptz(0)
  projects             projects              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestones_invoices  milestones_invoices[]
  project_work_types   project_work_types[]

  @@unique([project_id, milestone_no], map: "milestones_project_id_milestone_no_key")
}

model milestones_invoices {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestone_id   String     @db.Uuid
  invoice_number String?    @db.VarChar(100)
  net_value      Decimal    @db.Decimal(15, 2)
  note           String
  issued_date    DateTime?  @db.Date
  paid_at        DateTime?  @db.Date
  status         String     @default("OCZEKUJE") @db.VarChar(50)
  link           String?    @db.VarChar(500)
  /// Shared invoice this row belongs to (one invoice can settle several milestones)
  invoice_id     String?    @db.Uuid
  /// Share of the milestone settled by this row, in %
  percent        Decimal?   @db.Decimal(5, 2)
  milestones     milestones @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  invoices       invoices?  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}

/// Invoice requested by a works acceptance protocol; split into milestones_invoices rows per milestone
model invoices {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String                @db.Uuid
  invoice_number      String?               @db.VarChar(100)
  status              String                @default("OCZEKUJE") @db.VarChar(50)
  issued_date         DateTime?             @db.Date
  paid_at             DateTime?             @db.Date
  link                String?               @db.VarChar(500)
  note                String                @default("")
  protocol_file_id    String?               @db.VarChar(200)
  protocol_file_name  String?               @db.VarChar(255)
  protocol_mime_type  String?               @db.VarChar(150)
  created_by          Int?
  created_at          DateTime              @default(now()) @db.Timestamptz(0)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamptz(0)
  projects            projects              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author              User?                 @relation("invoices_created_byTousers", fields: [created_by], references: [id], onDelete: SetNull)
  milestones_invoices milestones_invoices[]
  invoice_works       invoice_works[]

  @@index([project_id])
}

/// Works closed by an invoice protocol (whole works only)
model invoice_works {
  invoice_id         String             @db.Uuid
  work_type_id       String             @db.Uuid
  invoices           invoices           @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  project_work_types project_work_types @relation(fields: [work_type_id], references: [id], onDelete: Cascade)

  @@id([invoice_id, work_type_id])
  @@index([work_type_id])
}

model planned_expenses {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id       String          @db.Uuid
  cost_category_id BigInt
  planned_percent  Decimal?        @db.Decimal(5, 2)
  planned_date     DateTime?       @db.Date
  cost_categories  cost_categories @relation(fields: [cost_category_id], references: [id])
  projects         projects        @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_departments {
  project_id    String      @db.Uuid
  department_id BigInt
  created_at    DateTime?   @default(now()) @db.Timestamptz(0)
  departments   departments @relation(fields: [department_id], references: [id])
  projects      projects    @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([project_id, department_id])
}

model project_department_foremen {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String      @db.Uuid
  department_id BigInt
  foreman_id    Int
  assigned_at   DateTime?   @default(now()) @db.Timestamptz(0)
  departments   departments @relation(fields: [department_id], references: [id])
  users         User        @relation(fields: [foreman_id], references: [id])
  projects      projects    @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_hours_plan {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String   @unique @db.Uuid
  average_hourly_rate Decimal? @db.Decimal(15, 2)
  planned_hours_total Decimal? @db.Decimal(15, 2)
  projects            projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_status_history {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String   @db.Uuid
  old_status String   @db.VarChar(100)
  new_status String   @db.VarChar(100)
  reason     String?
  changed_by Int
  changed_at DateTime @default(now()) @db.Timestamptz(0)
  users      User     @relation(fields: [changed_by], references: [id])
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_types {
  id          BigInt     @id @default(autoincrement())
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(255)
  description String?
  projects    projects[]
}

model project_work_types {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id       String          @db.Uuid
  milestone_id     String?         @db.Uuid
  department_id    BigInt
  name             String          @db.VarChar(255)
  unit             String?         @db.VarChar(20)
  percentage       Decimal?        @db.Decimal(5, 2)
  /// Share of the project hours plan for this work, in % (was work_type_hours_distribution)
  hours_percentage Decimal?        @db.Decimal(5, 2)
  total_quantity   Decimal?        @db.Decimal(15, 2)
  planned_start    DateTime?       @db.Date
  planned_end      DateTime?       @db.Date
  deleted_at       DateTime?       @db.Timestamptz(0)
  created_at       DateTime?       @default(now()) @db.Timestamptz(0)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(0)
  daily_reports    daily_reports[]
  invoice_works    invoice_works[]
  work_hours       work_hours[]
  departments      departments     @relation(fields: [department_id], references: [id])
  milestones       milestones?     @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  projects         projects        @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model projects {
  id                               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractor_id                    String                       @db.Uuid
  project_type_id                  BigInt
  manager_id                       Int?
  name                             String                       @db.VarChar(255)
  country                          String                       @db.VarChar(100)
  city                             String                       @db.VarChar(100)
  latitude                         Decimal?                     @db.Decimal(10, 7)
  longitude                        Decimal?                     @db.Decimal(10, 7)
  start_date_contract              DateTime?                    @db.Date
  end_date_contract                DateTime?                    @db.Date
  start_date_fact                  DateTime?                    @db.Date
  end_date_fact                    DateTime?                    @db.Date
  contract_net_value               Decimal?                     @db.Decimal(18, 2)
  currency                         String?                      @db.Char(3)
  vat_rate                         Decimal?                     @db.Decimal(5, 2)
  payment_term_days                Int?
  warranty_percent                 Decimal?                     @db.Decimal(5, 2)
  warranty_months                  Int?
  status                           String                       @default("DRAFT") @db.VarChar(100)
  hold_reason                      String?
  hold_started_at                  DateTime?                    @db.Timestamptz(0)
  expected_resume_date             DateTime?                    @db.Date
  google_drive_folder_id           String?                      @db.VarChar(100)
  dokumentation_url                String?                      @db.VarChar(512)
  pin_url                          String?                      @db.VarChar(512)
  deleted_at                       DateTime?                    @db.Timestamptz(0)
  created_by                       Int?
  updated_by                       Int?
  power                            Decimal?                     @db.Decimal(10, 2)
  created_at                       DateTime?                    @default(now()) @db.Timestamptz(0)
  updated_at                       DateTime?                    @default(now()) @db.Timestamptz(0)
  daily_reports                    daily_reports[]
  work_hours                       work_hours[]
  invoices                         invoices[]
  gathering_points                 project_gathering_points[]
  milestones                       milestones[]
  planned_expenses                 planned_expenses[]
  project_department_foremen       project_department_foremen[]
  project_departments              project_departments[]
  project_hours_plan               project_hours_plan?
  project_status_history           project_status_history[]
  project_work_types               project_work_types[]
  contractors                      contractors                  @relation(fields: [contractor_id], references: [id])
  users_projects_created_byTousers User?                        @relation("projects_created_byTousers", fields: [created_by], references: [id])
  currencies                       currencies?                  @relation(fields: [currency], references: [code])
  users_projects_manager_idTousers User?                        @relation("projects_manager_idTousers", fields: [manager_id], references: [id])
  project_types                    project_types                @relation(fields: [project_type_id], references: [id])
  users_projects_updated_byTousers User?                        @relation("projects_updated_byTousers", fields: [updated_by], references: [id])
}

model roles {
  id         BigInt       @id @default(autoincrement())
  code       String       @unique @db.VarChar(50)
  name       String       @db.VarChar(100)
  user_roles user_roles[]
}

model user_roles {
  user_id Int
  role_id BigInt
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model google_sheets_sync_errors {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_name    String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  payload       String?  @db.Text
  error_message String   @db.Text
  user_id       Int?
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

/// Gathering points on the construction site (several per project). The site itself is located by
/// projects.pin_url / latitude / longitude; these are the named spots where crews meet.
model project_gathering_points {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  name       String    @db.VarChar(150)
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  created_at DateTime  @default(now()) @db.Timestamptz(0)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  deleted_at DateTime? @db.Timestamptz(0)
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}

/// Hourly surcharges (dopłaty) paid on top of the base rate, e.g. for difficult conditions.
/// Managed by an admin in Settings; the brigade app (ST_BR) reads the ones valid on a given day.
model surcharges {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                 @db.VarChar(150)
  rate_per_hour Decimal                @db.Decimal(10, 2)
  valid_from    DateTime               @db.Date
  /// Empty = valid with no end date
  valid_to      DateTime?              @db.Date
  is_active     Boolean                @default(true)
  created_at    DateTime               @default(now()) @db.Timestamptz(0)
  updated_at    DateTime               @default(now()) @updatedAt @db.Timestamptz(0)
  work_hours    work_hour_surcharges[]

  @@index([is_active, valid_from])
}

/// One-time sign-in codes of the brigade app. Foremen are not ERP users: TMA confirms them by phone.
model brigade_auth_codes {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "+48123456789"
  phone               String    @db.VarChar(16)
  code                String    @db.VarChar(12)
  /// Foreman id in TMA, as answered when the code was sent
  foreman_external_id String    @db.VarChar(64)
  expires_at          DateTime  @db.Timestamptz(0)
  /// Wrong guesses; the code is burned after a few
  attempts            Int       @default(0)
  used_at             DateTime? @db.Timestamptz(0)
  user_agent          String?   @db.VarChar(255)
  created_at          DateTime  @default(now()) @db.Timestamptz(0)

  @@index([phone, created_at])
}

/// Sessions of the brigade app (until 23:59 Warsaw time). The refresh token rotates, the session id stays.
model brigade_sessions {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foreman_external_id String    @db.VarChar(64)
  phone               String    @db.VarChar(16)
  first_name          String    @db.VarChar(255)
  last_name           String    @db.VarChar(255)
  refresh_token       String    @unique @db.VarChar(64)
  expires_at          DateTime  @db.Timestamptz(0)
  revoked_at          DateTime? @db.Timestamptz(0)
  user_agent          String?   @db.VarChar(255)
  created_at          DateTime  @default(now()) @db.Timestamptz(0)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(0)

  @@index([foreman_external_id])
}

/// Work log of the brigade app: one row = worker × work type × day (written by the foreman).
/// Foremen and workers live in TMA, so they are kept as TMA ids with a name snapshot of that day.
/// Empty for now: saving the day form is not built yet.
/// Hours of the brigade app: one line of the day form (worker × project × work type). Nothing writes here yet.
model work_hours {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  work_date           DateTime               @db.Date
  project_id          String                 @db.Uuid
  work_type_id        String                 @db.Uuid
  /// Foreman (TMA manager) who wrote the day
  manager_id          Int?
  manager_name        String?                @db.VarChar(255)
  /// Worker in TMA and his data on that day
  worker_id           BigInt
  worker_name         String                 @db.VarChar(255)
  worker_company_name String                 @db.VarChar(255)
  position            String                 @default("") @db.VarChar(255)
  /// TMA work day event (the QR check-in) the hours come from; several lines (work types) can share one
  work_day_event_id   String                 @db.Uuid
  hours               Int
  note                String                 @default("") @db.VarChar(2000)
  projects            projects               @relation(fields: [project_id], references: [id])
  project_work_types  project_work_types     @relation(fields: [work_type_id], references: [id])
  surcharges          work_hour_surcharges[]

  @@index([work_date, manager_id])
  @@index([worker_id, work_date])
  @@index([project_id, work_date])
  @@index([work_type_id])
  @@index([work_day_event_id])
}

/// Surcharges («Warunki») of a work row: many-to-many, like user_roles. The rate is kept as it was that day.
model work_hour_surcharges {
  work_hour_id  String     @db.Uuid
  surcharge_id  String     @db.Uuid
  rate_per_hour Decimal    @db.Decimal(10, 2)
  work_hours    work_hours @relation(fields: [work_hour_id], references: [id], onDelete: Cascade)
  surcharges    surcharges @relation(fields: [surcharge_id], references: [id], onDelete: Restrict)

  @@id([work_hour_id, surcharge_id])
  @@index([surcharge_id])
}
